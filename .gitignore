# =============================================================================
# parag-agency — Git ignore
# =============================================================================
# workflow: کد + .env.example → GitHub → روی سرور pull → cp .env.example .env.local
# =============================================================================

# ── وابستگی‌ها ────────────────────────────────────────────────────────────────
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── خروجی build ───────────────────────────────────────────────────────────────
/.next/
/out/
/build/

# ── متغیرهای محیطی (حساس) ─────────────────────────────────────────────────────
# PAYLOAD_URL, NEXT_PUBLIC_TENANT, PREVIEW_SECRET — فقط روی سرور/لوکال
.env
.env.*
.env*.local
!.env.example

# ── تست ───────────────────────────────────────────────────────────────────────
/coverage/

# ── IDE / سیستم‌عامل ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── لاگ و کلید ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pem
*.key

# ── TypeScript / deploy platforms ─────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
.vercel

# ── Server-only (SSL / hosting) ───────────────────────────────────────────────
.well-known/
