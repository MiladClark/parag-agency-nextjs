NODE_ENV=production
PORT=3602
HOSTNAME=0.0.0.0

# Content: payload | db | file (default file if unset)
CONTENT_SOURCE=payload
PAYLOAD_URL=https://your-cms-host
NEXT_PUBLIC_PAYLOAD_URL=https://your-cms-host
NEXT_PUBLIC_TENANT=parag
NEXT_PUBLIC_SITE_URL=https://parag.agency
PREVIEW_SECRET=change-me

# Server-only CMS cache control. Match the key configured in Payload.
# Use a random value of at least 32 characters; never prefix with NEXT_PUBLIC_.
# CACHE_REVALIDATION_SECRET=
